# Sync Center — variables de entorno (defaults por entorno)
#
# Solo son DEFAULTS: definen con qué arranca la app la primera vez.
# Lo que el operador guarde en la pantalla de Ajustes los sobrescribe.
#
# Vite carga estos archivos según el modo:
#   pnpm tauri dev    -> .env + .env.development
#   pnpm tauri build  -> .env + .env.production
#   pnpm dev --mode staging  -> .env + .env.staging
# Los secretos por máquina van en .env.local / .env.[modo].local (ignorados por git).

VITE_GRS_BASE_URL=http://localhost:3010/api
VITE_ZEMPO_BASE_URL=http://localhost:3001/zempo
VITE_ATH_BASE_URL=http://localhost:3005/api/ath
VITE_LANGUAGE=spa

# API keys — NO las pongas aquí en repos compartidos.
# Úsalas en .env.local (ignorado) o, mejor, en la pantalla de Ajustes.
VITE_ZEMPO_API_KEY=
VITE_ATH_API_KEY=
